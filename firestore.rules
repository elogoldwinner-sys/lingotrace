rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsClass(classId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    // True if the signed-in user's own portal account (studentAccounts/{uid})
    // is linked to the given studentId — i.e. "is this me?" for a student.
    function isLinkedStudent(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/studentAccounts/$(request.auth.uid)).data.studentId == studentId;
    }

    // True if the signed-in user is a parent account linked to the given
    // studentId. Checks the current `studentIds` array (multi-child support)
    // and falls back to the legacy single `studentId` field for parent
    // accounts created before multi-child support existed.
    function isLinkedParent(studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
        (
          studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.get('studentIds', []) ||
          get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.get('studentId', '') == studentId
        );
    }


    // ---- School portal helpers (principal / department head / counselor …) ----

    // The school's id is its principal's uid, so "am I the principal of this school" is a path check.
    function isSchoolPrincipal(schoolId) {
      return isSignedIn() && schoolId == request.auth.uid &&
        exists(/databases/$(database)/documents/schools/$(schoolId));
    }

    // Staff access docs are keyed by the person's lower-cased verified Gmail.
    function hasStaff() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower()));
    }

    function staffSchool() {
      return get(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower())).data.schoolId;
    }

    // May this staff member read a class with the given data?
    //  principal            -> every class of the school
    //  departmentHead       -> classes whose subject is theirs
    //  counselor            -> classes in their grades / class keys (any subject)
    //  supervisor/coordinator -> their head's subject AND their grades / class keys
    // Call only after hasStaff().
    function staffMaySeeClassData(c) {
      let a = get(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower())).data;
      let inScope = a.get('allClasses', false) == true ||
        c.get('grade', -1) in a.get('grades', []) ||
        c.get('classKey', '') in a.get('classKeys', []);
      let subjectOk = c.get('subject', '') == a.get('subject', '');
      return c.get('schoolId', '') != '' && c.get('schoolId', '') == a.schoolId && (
        a.role == 'principal' ||
        (a.role == 'departmentHead' && subjectOk) ||
        (a.role == 'counselor' && inScope) ||
        ((a.role == 'supervisor' || a.role == 'coordinator') && subjectOk && inScope)
      );
    }

    function staffMaySeeClass(classId) {
      return hasStaff() &&
        staffMaySeeClassData(get(/databases/$(database)/documents/classes/$(classId)).data);
    }

    // A teacher may stamp a school on a class only if the principal approved them for that school.
    function approvedTeacherOf(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/schoolTeachers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/schoolTeachers/$(request.auth.uid)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/schoolTeachers/$(request.auth.uid)).data.status == 'approved';
    }

    // A department head may hand out supervisor / coordinator access, limited to their own subject.
    function headMayGrant(d) {
      let a = get(/databases/$(database)/documents/staffAccess/$(request.auth.token.email.lower())).data;
      return a.role == 'departmentHead' && d.schoolId == a.schoolId &&
        d.role in ['supervisor', 'coordinator'] && d.subject == a.subject &&
        d.addedByUid == request.auth.uid;
    }

    // Each teacher can read/write only their own profile document
    match /teachers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // A parent's portal account (doc id = their own auth uid). `studentIds`
    // is the only field ever allowed to change after creation, and only by
    // growing (adding another child) — see addChildToParent.
    match /parents/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentIds"]) &&
        request.resource.data.studentIds.size() >= resource.data.get('studentIds', []).size();
      allow delete: if false;
    }

    // Maps a student's auth uid -> their roster studentId (doc id = their own auth uid)
    match /studentAccounts/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update, delete: if false;
    }

    // Class join links. Anyone with the exact token can read it (needed to
    // resolve /join/:token before the visitor has signed in) — the collection
    // is never listable, so a token must already be known to look it up.
    match /invites/{token} {
      allow get: if true;
      // A teacher looking up "do I already have an invite for this class+role"
      // (getOrCreateInvite) needs to run a `where(classId==, role==)` query.
      // That's a list operation, so it must be explicitly allowed here — this
      // was previously `if false`, which silently broke the invite-link
      // buttons (Firestore rejected the query with permission-denied before
      // any invite could ever be created or copied).
      allow list: if isSignedIn() && ownsClass(resource.data.classId);
      // Class sharing is exclusive to parents — students are added to the
      // roster manually by the teacher — so only parent-role invites can be
      // newly created. Older student-role invite docs (from before this
      // change) are untouched and still resolve via `get` above.
      allow create: if ownsClass(request.resource.data.classId) &&
        request.resource.data.role == "parent";
      allow update, delete: if false;
    }

    // True when the signed-in Google account's (verified) email is the one a
    // subject class was created for.
    function isInvitedCoTeacher(data) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        data.get('teacherEmail', '') == request.auth.token.email.lower();
    }

    // A teacher manages the classes they run. Subject classes: the classroom
    // teacher (`ownerId`) creates one for a co-teacher's Gmail with
    // `teacherId == ""`, can see it, and can remove it at any time (removing
    // the teacher). The invited co-teacher claims it on first sign-in by setting
    // `teacherId` to their own uid (nothing else may change in that update);
    // from then on the owner can only remove the subject as a whole; they
    // cannot read or edit its students/points.
    match /classes/{classId} {
      allow read: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        (resource.data.teacherId == '' && isInvitedCoTeacher(resource.data))
      ) || (hasStaff() && staffMaySeeClassData(resource.data));
      // The avatar collection (Boys / Girls / Mixed) can be set once and never changed after.
      // A school link (schoolId) can only be set by a teacher the principal approved; a principal may only CLEAR it
      // (when removing a teacher from the school).
      allow update: if (isSignedIn() &&
        (!('avatarGender' in resource.data) ||
          request.resource.data.get('avatarGender', '') == resource.data.avatarGender) &&
        (request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') ||
          request.resource.data.get('schoolId', '') == '' ||
          approvedTeacherOf(request.resource.data.schoolId)) && (
        resource.data.teacherId == request.auth.uid ||
        (resource.data.teacherId == '' && isInvitedCoTeacher(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["teacherId"]) &&
          request.resource.data.teacherId == request.auth.uid)
      )) || (isSchoolPrincipal(resource.data.get('schoolId', '')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["schoolId"]) &&
        request.resource.data.get('schoolId', '') == '');
      allow delete: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.teacherId == request.auth.uid ||
        (request.resource.data.teacherId == '' &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.teacherEmail is string &&
          ownsClass(request.resource.data.parentClassId))
      ) && (request.resource.data.get('schoolId', '') == '' ||
          approvedTeacherOf(request.resource.data.schoolId));
    }

    // Students belong to a class. The teacher who owns the class has full
    // access. A signed-in student/parent can read their own linked record.
    // Listing (without auth) is allowed so the public /join page can show a
    // "pick your name" / "pick your child" roster for a specific class —
    // note this means roster info (names, parent contact fields) for a class
    // is readable by anyone who knows its classId, not just invite holders.
    match /students/{studentId} {
      allow get: if ownsClass(resource.data.classId) ||
        staffMaySeeClass(resource.data.classId) ||
        isLinkedStudent(studentId) || isLinkedParent(studentId);
      allow list: if true;
      allow update: if ownsClass(resource.data.classId) ||
        (isSignedIn() && resource.data.authUid == null &&
          request.resource.data.authUid == request.auth.uid) ||
        (isLinkedParent(studentId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["parentName", "parentEmail", "parentUids"])) ||
        // A student may choose their picture from the built-in gallery exactly once.
        (isLinkedStudent(studentId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["photoURL", "avatarPicked"]) &&
          resource.data.get('avatarPicked', false) == false &&
          request.resource.data.avatarPicked == true &&
          request.resource.data.photoURL.matches('.*/avatars/(boys|girls)-[0-9]+[.]webp'));
      allow create: if ownsClass(request.resource.data.classId) ||
        (isSignedIn() && request.resource.data.authUid == request.auth.uid);
      allow delete: if ownsClass(resource.data.classId);
    }

    match /attendance/{recordId} {
      allow read: if ownsClass(resource.data.classId) ||
        isLinkedStudent(resource.data.studentId) || isLinkedParent(resource.data.studentId);
      allow update, delete: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId);
    }

    match /sessions/{sessionId} {
      allow read, update, delete: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId);
    }

    // Notes are owned directly by the teacher who authored them. A parent may
    // also read a note about their child once it's marked visibleToParent.
    match /notes/{noteId} {
      allow read: if (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (resource.data.visibleToParent == true && isLinkedParent(resource.data.studentId));
      // The author can edit / delete; the linked parent may ONLY toggle the "read" mark.
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (resource.data.visibleToParent == true && isLinkedParent(resource.data.studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent', 'readAt']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    // True when the signed-in teacher is the classroom teacher (`ownerId`) who
    // added the subject class `classId` for a co-teacher. Read-only: lets the
    // classroom teacher compare points across subjects (Class statistics →
    // "Across subjects"). Only reads are granted — the co-teacher alone can
    // still create, edit or delete their own points.
    // A school principal can switch this comparison off for the school's teachers (schools/{id}.allowSubjectCompare).
    function isSubjectOwner(classId) {
      let c = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isSignedIn() && c.get('ownerId', '') == request.auth.uid &&
        (c.get('schoolId', '') == '' ||
          get(/databases/$(database)/documents/schools/$(c.schoolId)).data.get('allowSubjectCompare', true) != false);
    }

    // Points transactions are owned by the teacher who awarded them. The
    // student they're about, or that student's parent, may also read them.
    match /pointsTransactions/{txnId} {
      allow read: if (isSignedIn() && resource.data.awardedBy == request.auth.uid) ||
        staffMaySeeClass(resource.data.classId) ||
        isLinkedStudent(resource.data.studentId) || isLinkedParent(resource.data.studentId) ||
        isSubjectOwner(resource.data.classId);
      allow update, delete: if isSignedIn() && resource.data.awardedBy == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.awardedBy == request.auth.uid;
    }

    // Project assignments. `get` (single-doc read by id) is public because
    // the /submit/:projectId page has to look up a project before the
    // visiting student has necessarily signed in yet — same pattern as
    // /invites/{token} above. The collection is never listable without
    // owning the class, so a project can only be found by already knowing
    // its exact id (the shared submission link).
    match /projects/{projectId} {
      allow get: if true;
      allow list: if ownsClass(resource.data.classId);
      allow create: if ownsClass(request.resource.data.classId);
      allow update, delete: if ownsClass(resource.data.classId);
    }

    // Announcements — one doc per post (auto id), each optionally targeted at
    // specific classes via `classIds` (absent/empty = everyone). The original
    // single school-wide announcement lives on as announcements/current.
    //
    // Any signed-in user can read, because a Firestore rule can't filter a
    // list query by "is one of my classes in this doc's classIds" — so the
    // student and parent portals show only the announcements meant for their
    // class. That makes targeting a display rule, not secret-keeping: don't
    // put anything in an announcement that no signed-in user should see.
    //
    // Only a signed-in teacher (verified by having their own teachers/{uid}
    // profile doc) can write, and only their own posts: `authorId` must be
    // their uid on create/update, and they can only edit or delete a post
    // whose `authorId` is theirs. Posts with no `authorId` (the original
    // announcements/current) can be edited or removed by any teacher.
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.authorId == request.auth.uid &&
        resource.data.get('authorId', request.auth.uid) == request.auth.uid;
      allow delete: if isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        resource.data.get('authorId', request.auth.uid) == request.auth.uid;
    }

    // A class's current weekly top-3 (doc id = classId, overwritten each
    // week). Readable by anyone, matching the existing posture of
    // /students/{studentId} above — that roster is already listable
    // without auth (needed for the join page), so this doesn't expose
    // anything a visitor couldn't already see by knowing the classId. Only
    // written by that class's own teacher: only a teacher's client has read
    // access to every student's points needed to compute it.
    match /classRankings/{classId} {
      allow read: if true;
      allow write: if ownsClass(classId);
    }

    // Submissions. Doc id is deterministic (`${projectId}_${studentId}`) and
    // a student's submit/resubmit always upserts via setDoc(merge:true) —
    // Firestore evaluates that as "create" the first time and "update" on
    // every resubmission, so the student needs both. A student may only ever
    // touch their own submission's link/note/submittedAt; grading fields
    // (awardedMark/teacherNote/gradedAt) can only be written by the
    // class's teacher.
    match /submissions/{submissionId} {
      allow read: if ownsClass(resource.data.classId) ||
        isLinkedStudent(resource.data.studentId) || isLinkedParent(resource.data.studentId);
      allow create: if isLinkedStudent(request.resource.data.studentId);
      allow update: if ownsClass(request.resource.data.classId) ||
        (isLinkedStudent(resource.data.studentId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["link", "note", "submittedAt"]));
      allow delete: if ownsClass(resource.data.classId);
    }

    // ---- Linked activities (GATway exams / LingoBite Play games) ----

    // An exam/game a teacher assigned to a class by pasting its link.
    // Any signed-in user may read (a rule can't filter a list query by "is
    // this my child's class"), so the portals show only their own class's
    // items by querying on classId. Only titles and links live here.
    // Only the teacher who runs the class can create, edit or delete.
    match /linkedAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if ownsClass(request.resource.data.classId) &&
        request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if ownsClass(resource.data.classId);
    }

    // Scores reported back by GATway / Play. Doc id = `${assignmentId}_${studentId}`.
    // Per the app's design these are written by their backends, never by a
    // LingoTrace client, so clients get read-only access. If GATway/Play write
    // from a browser client instead of a backend, this needs a create rule.
    match /linkedResults/{resultId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Marks a teacher has already turned into points ("Add 10 marks").
    // Doc id = `${assignmentId}_${studentId}`. The client first reads the doc
    // inside a transaction to see whether it exists, so `read` must also
    // succeed when the doc does not exist yet (resource == null). The claim is
    // deleted again if awarding the points fails, hence `delete`.
    match /linkedMarkAwards/{awardId} {
      // Portals also read this doc, to hide exams/games whose mark was already
      // added, so the linked student/parent and the class's teacher may read it.
      allow read: if isSignedIn() &&
        (resource == null ||
          resource.data.awardedBy == request.auth.uid ||
          ownsClass(resource.data.classId) ||
          isLinkedStudent(resource.data.studentId) ||
          isLinkedParent(resource.data.studentId));
      allow create: if isSignedIn() &&
        request.resource.data.awardedBy == request.auth.uid &&
        ownsClass(request.resource.data.classId);
      allow delete: if isSignedIn() && resource.data.awardedBy == request.auth.uid;
      allow update: if false;
    }

    // ---- Schools, staff portals, approvals, audit trail, feedback log ----

    // The school's public face (name, logo, approved subjects, settings). Any signed-in teacher can read it
    // (needed to pick their school when signing up). Only its principal can write it.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && schoolId == request.auth.uid &&
        request.resource.data.principalUid == request.auth.uid;
      allow update: if isSignedIn() && schoolId == request.auth.uid &&
        request.resource.data.principalUid == request.auth.uid;
      allow delete: if false;

      // Who opened / printed which report, approvals… Append-only; only the principal can read it.
      match /audit/{entryId} {
        allow read: if isSchoolPrincipal(schoolId);
        allow create: if hasStaff() && staffSchool() == schoolId &&
          request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Feedback sent by staff (only when they chose to record it). The principal reads all; authors read their own.
      match /feedback/{entryId} {
        allow read: if isSchoolPrincipal(schoolId) ||
          (isSignedIn() && resource.data.authorUid == request.auth.uid);
        allow create: if hasStaff() && staffSchool() == schoolId &&
          request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Signature and stamp images — kept out of the publicly readable school doc.
    match /schoolAssets/{schoolId} {
      allow read: if isSchoolPrincipal(schoolId) || (hasStaff() && staffSchool() == schoolId);
      allow write: if isSchoolPrincipal(schoolId);
    }

    // Who may use the school portal, and with what scope (doc id = lower-cased Gmail).
    match /staffAccess/{email} {
      allow get: if isSignedIn() && request.auth.token.email != null &&
        (request.auth.token.email.lower() == email || isSchoolPrincipal(resource.data.schoolId));
      allow list: if isSignedIn() &&
        (isSchoolPrincipal(resource.data.schoolId) || resource.data.addedByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.email == email && (
        (isSchoolPrincipal(request.resource.data.schoolId) &&
          request.resource.data.addedByUid == request.auth.uid) ||
        (hasStaff() && headMayGrant(request.resource.data)));
      allow update: if isSignedIn() && request.resource.data.email == email &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.role == resource.data.role && (
        isSchoolPrincipal(resource.data.schoolId) ||
        (hasStaff() && resource.data.addedByUid == request.auth.uid && headMayGrant(request.resource.data)));
      allow delete: if isSignedIn() && (
        isSchoolPrincipal(resource.data.schoolId) ||
        (hasStaff() && resource.data.addedByUid == request.auth.uid && resource.data.role in ['supervisor', 'coordinator']));
    }

    // A teacher's request to join a school (doc id = the teacher's uid). It can only be CREATED as "pending";
    // only the principal can change the status to approved / rejected.
    match /schoolTeachers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid ||
        isSchoolPrincipal(resource.data.schoolId) ||
        (hasStaff() && staffSchool() == resource.data.schoolId));
      allow list: if isSignedIn() && (isSchoolPrincipal(resource.data.schoolId) ||
        (hasStaff() && staffSchool() == resource.data.schoolId));
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid && request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId));
      allow update: if isSignedIn() && (
        (isSchoolPrincipal(resource.data.schoolId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'subject'])) ||
        (request.auth.uid == uid && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsapp', 'name', 'email', 'classMap']) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subject', 'status', 'classMap', 'schoolId']) &&
            request.resource.data.status == 'pending'))));
      allow delete: if isSignedIn() && (request.auth.uid == uid || isSchoolPrincipal(resource.data.schoolId));
    }
  }
}
